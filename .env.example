# ============================================================
# CONFIGURACIÓN DE ENTORNO - PM/DAM SYSTEM
# ============================================================

# Base de Datos
# PostgreSQL connection string
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/pmdam?schema=public"

# NextAuth.js (si usas autenticación)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# JWT Secret
JWT_SECRET="your-jwt-secret-change-this-in-production"

# API Configuration
API_URL="http://localhost:3000/api"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Storage (S3 o similar)
# AWS S3
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="pm-dam-assets"

# O usa Cloudflare R2
# R2_ACCOUNT_ID="your-account-id"
# R2_ACCESS_KEY_ID="your-access-key"
# R2_SECRET_ACCESS_KEY="your-secret-key"
# R2_BUCKET_NAME="pm-dam-assets"

# Redis (opcional - para cache)
REDIS_URL="redis://localhost:6379"

# Webhooks
WEBHOOK_SECRET="your-webhook-secret"

# Integraciones (opcional)
# Slack
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"

# Email (opcional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@pmdam.com"

# Modo de desarrollo
NODE_ENV="development"

# Puerto del servidor
PORT="3000"

# Logging
LOG_LEVEL="info" # debug, info, warn, error

# Uploads
MAX_FILE_SIZE="52428800" # 50MB en bytes
ALLOWED_FILE_TYPES="image/*,video/*,audio/*,application/pdf,application/msword"

# Rate Limiting
RATE_LIMIT_WINDOW="900000" # 15 minutos en ms
RATE_LIMIT_MAX_REQUESTS="100"

# Feature Flags (opcional)
FEATURE_AI_DIRECTORY="true"
FEATURE_WORKFLOWS="true"
FEATURE_ANALYTICS="true"
FEATURE_NOTIFICATIONS="true"
